# ==========================================
# Laravel Backend
# ==========================================

# Environment files (JANGAN pernah commit!)
.env
.env.*
!.env.example

# Dependencies
/vendor/

# Laravel generated
/bootstrap/cache/*.php
/public/storage
/public/hot

# Storage (logs, sessions, cache)
/storage/*.key
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/pail
!storage/logs/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/testing/.gitkeep
!storage/framework/views/.gitkeep

# Node modules (Laravel Mix/Vite)
/node_modules/
/public/build/

# PHPUnit cache
.phpunit.result.cache
/.phpunit.cache

